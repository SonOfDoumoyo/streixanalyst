# Copy to .env (or run ./init-env.sh, which does this and fills the secrets). Never commit .env.

# ── required ─────────────────────────────────────────────────────────────────────────────────────────────────
# The address people open. A domain you own pointed at this VM, or free: <your-ip-with-dashes>.sslip.io
DOMAIN=
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── strategy watches: lets a scheduler wake/scan from outside (optional on this always-on VM) ────────────────
CRON_SECRET=

# ── email (Brevo): confirmation links, password resets, watch alerts ─────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=StreixAnalyst <you@gmail.com>

# ── phone / browser notifications (see backend/.env.example for how to make the keys) ───────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── connect a broker: MetaTrader through MetaApi (paid). Leave empty to keep the MetaTrader option off ───────
METAAPI_TOKEN=
BROKER_KEY=

# ── the rest of backend/.env.example works here too: StreixAI keys, Paystack, OPay, Google sign-in, Twelve Data ─
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
