# ───────── StreixAnalyst backend settings ─────────
# Copy to .env (local) or paste into your host's environment variables. Never commit real secrets.

ENV=production
# a long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# where people open the app (the Next.js site). The site forwards /api to this server.
FRONTEND_URL=https://streixanalyst.onrender.com
# PUBLIC_API_URL defaults to FRONTEND_URL/api (OAuth + payment callbacks go through the site)
# CORS_ORIGINS=https://streixanalyst.onrender.com

# database: PostgreSQL in production (Render gives you this URL). SQLite if empty.
DATABASE_URL=
# folder for caches, uploads and the SQLite file
DATA_DIR=/var/data
# the trained model (upload it with POST /api/brain/upload as admin)
GURU_BRAIN_PATH=/var/data/models/guru_brain.joblib
ANALYSIS_WORKERS=2

# your admin login (created/updated at start-up; this env value is the source of truth)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# new accounts get this many days of full access, then the free plan
TRIAL_DAYS=7

# ───────── email (needed for sign-up confirmation and password resets) ─────────
# Any SMTP provider works (Brevo, Resend, Mailgun, Gmail with an app password). Without SMTP, accounts count as confirmed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StreixAnalyst <no-reply@example.com>

# ───────── sign in with Google / LinkedIn (optional) ─────────
# Google Cloud Console → Credentials → OAuth client (Web).
# Redirect URI: https://streixanalyst.onrender.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn Developers → app → Products: "Sign In with LinkedIn using OpenID Connect".
# Redirect URI: https://streixanalyst.onrender.com/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ───────── StreixAI (optional; without a key it answers from its built-in trading notes) ─────────
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
STREIXAI_MODEL=claude-sonnet-5-5
STREIXAI_MODEL_FAST=claude-haiku-5-5
# or any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ───────── payments ─────────
# Prices are set in dollars (Admin → Prices). Naira charges use USD_NGN_RATE.
USD_NGN_RATE=1550

# Card and bank transfer via Paystack. Webhook URL: https://streixanalyst.onrender.com/api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# personal account numbers per user (needs Paystack's approval for Dedicated Virtual Accounts)
PAYSTACK_DVA_ENABLED=0
PAYSTACK_DVA_BANK=wema-bank

# OPay Checkout (merchant account at opaycheckout.com). Leave empty to hide it.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_BASE_URL=https://liveapi.opaycheckout.com

# USDT crypto payments, confirmed on the blockchain automatically. Leave the wallet empty to hide it.
# CRYPTO_NETWORK: trc20 (Tron, lowest fees, recommended), bep20 (BNB Smart Chain) or erc20 (Ethereum)
CRYPTO_NETWORK=trc20
CRYPTO_WALLET_ADDRESS=
# a free API key from TronGrid (for trc20) or Etherscan (for bep20/erc20), used to read incoming transfers
CRYPTO_EXPLORER_API_KEY=

# ───────── public contact details (the Contact page shows only what you fill in) ─────────
TERMS_VERSION=2026-10-15
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_COMPANY_EMAIL=
CONTACT_GITHUB=
CONTACT_LINKEDIN=

# ───────── market data: Twelve Data (paid plan: live metals, commodities, indices, stocks and forex) ─────────
# Off until you have a plan. While it is off, the free sources answer.
# Set TWELVEDATA_ENABLED=1 and paste your key to switch it on.
TWELVEDATA_ENABLED=0
TWELVEDATA_API_KEY=

# ───────── phone alerts (Web push, optional) ─────────
# Make the keys once, on your computer:
#   pip install pywebpush
#   vapid --gen                    (writes private_key.pem and public_key.pem)
#   vapid --applicationServerKey   (prints the public key after an equals sign; paste it below)
# Paste the private key's PEM text on one line, with \n where the line breaks are.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact for the push services, e.g. mailto:you@example.com (leave empty to use ADMIN_EMAIL)
VAPID_SUBJECT=
