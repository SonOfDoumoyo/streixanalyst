# ───────── StreixAnalyst backend settings ─────────
# Copy to .env (local) or paste into your host's environment variables. Never commit real secrets.

ENV=production
# a long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# where people open the app (the Next.js site). The site forwards /api to this server.
FRONTEND_URL=https://streixanalyst.com
# PUBLIC_API_URL defaults to FRONTEND_URL/api (OAuth + payment callbacks go through the site)
# CORS_ORIGINS=https://streixanalyst.com

# database: PostgreSQL in production (Render/Railway/Supabase/Neon give you this URL). SQLite if empty.
DATABASE_URL=
# folder for caches, uploads (payment receipts) and the SQLite file; put it on a persistent disk
DATA_DIR=/var/data
# the trained model from notebook 6 (Google Drive: trading_ai/guru/guru_brain.joblib)
GURU_BRAIN_PATH=/var/data/models/guru_brain.joblib
ANALYSIS_WORKERS=2

# your admin login (created/updated at start-up; this env value is the source of truth)
ADMIN_EMAIL=you@streixcorp.com
ADMIN_PASSWORD=choose-a-strong-password

TRIAL_DAYS=30

# ───────── sign in with Google / LinkedIn (optional) ─────────
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: https://streixanalyst.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn Developers → app → Products: "Sign In with LinkedIn using OpenID Connect".
# Redirect URI: https://streixanalyst.com/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ───────── StreixAI (optional; without a key it answers from its built-in trading notes) ─────────
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
STREIXAI_MODEL=claude-sonnet-5-5
STREIXAI_MODEL_FAST=claude-haiku-5-5
# or any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ───────── payments ─────────
# Paystack dashboard → Settings → API keys & webhooks. Webhook URL: https://streixanalyst.com/api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# personal account numbers per user (needs Paystack's approval for Dedicated Virtual Accounts)
PAYSTACK_DVA_ENABLED=0
PAYSTACK_DVA_BANK=wema-bank

# OPay Checkout (merchant account at opaycheckout.com). Leave empty to hide it.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_BASE_URL=https://liveapi.opaycheckout.com

# Accounts shown for direct transfers (users upload a receipt, you approve it in Admin → Payments).
# You can also edit these later in Admin → Prices & accounts.
MANUAL_ACCOUNTS=[{"bank":"OPay","number":"9160309499","name":"NIMI DOUMOYO MEREMUBIO"},{"bank":"UBA","number":"2385227704","name":"NIMI DOUMOYO MEREMUBIO"}]

# ───────── email (optional: password resets, payment confirmations) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StreixAnalyst <no-reply@streixanalyst.com>

# ── v1.3: site, terms and contact (fill these in; the Contact page shows only what you fill in) ──
# Change TERMS_VERSION when the Terms change, so each sign-up records the version they agreed to.
TERMS_VERSION=2026-10-15
# Naira per US dollar. Card and bank payments are charged in naira at this rate.
USD_NGN_RATE=1550
CONTACT_PHONE=09138565782
CONTACT_EMAIL=nimidoumoyo@gmail.com
CONTACT_COMPANY_EMAIL=streixcorp@gmail.com
CONTACT_GITHUB=@Sonofdoumoyo
# Paste your LinkedIn profile link on the next line, after the equals sign.
CONTACT_LINKEDIN=

# ───────── market data: Twelve Data (paid plan, for live metals, indices and forex) ─────────
# Off until you have a plan. While it is off, forex, metals and indices use Dukascopy and Yahoo.
# Set TWELVEDATA_ENABLED=1 and paste your key to switch it on.
TWELVEDATA_ENABLED=0
TWELVEDATA_API_KEY=

# ───────── phone alerts (Web push, optional) ─────────
# Price and strategy alerts reach your phone or computer, even when the site is closed. Off until all three are set.
# Make the keys once, on your computer:
#   pip install pywebpush
#   vapid --gen                    (writes private_key.pem and public_key.pem)
#   vapid --applicationServerKey   (prints the public key after an equals sign; paste it below)
# Keep the private key secret. Paste its PEM text on one line, with \n where the line breaks are.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact for the push services, e.g. mailto:you@example.com (leave empty to use ADMIN_EMAIL)
VAPID_SUBJECT=
